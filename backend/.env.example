# Environment variables for PhishGuard AI backend

# App
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database (SQLite for local demo, set to postgresql:// for production)
DATABASE_URL=sqlite+aiosqlite:///./phishguard.db

# CORS - comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload limits
MAX_UPLOAD_SIZE_MB=5

# Optional: enable real DNS checks (requires internet)
ENABLE_DNS_CHECKS=false

# Optional: VirusTotal API key for URL scanning (leave blank to skip)
VIRUSTOTAL_API_KEY=

# Report directory
REPORT_DIR=./reports
